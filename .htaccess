# ============================================================
#  Seguridad y reescritura — InfinityFree / Apache
# ============================================================

RewriteEngine On

# ---- Forzar HTTPS ----
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- No listar directorios ----
Options -Indexes

# ---- URLs limpias: /resultados -> resultados.php ----
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# ---- Archivos que nunca deben servirse ----
# Datos crudos, fuentes del VPS, configuración y artefactos de depuración.
<FilesMatch "\.(json|py|md|sh|flag|txt|sqlite|db|log|out|yml|example\.php)$">
    Require all denied
</FilesMatch>

# Excepción: el manifiesto público, si algún día se añade.
<Files "manifest.json">
    Require all granted
</Files>

# ---- Configuración y credenciales ----
<FilesMatch "^(config_db|secrets|secrets\.example|security)\.php$">
    Require all denied
</FilesMatch>

# ---- Panel de administración: restringir por IP ----
# Sustituir por la IP fija desde la que se administra. Mientras esté en
# 127.0.0.1 el panel queda cerrado a internet, que es el estado seguro por
# defecto: antes era accesible por cualquiera sin autenticación.
<Files "panel_admin.php">
    Require ip 127.0.0.1
</Files>

# ---- Filtro básico de inyección en la query string ----
RewriteCond %{QUERY_STRING} (?:%27|'|%22|").*(?:%20|\s|%2B|\+)*(?:union|select|insert|update|delete|drop|truncate) [NC,OR]
RewriteCond %{QUERY_STRING} (?:%3C|<).*script.*(?:%3E|>) [NC]
RewriteRule ^ - [F]

# NOTA: aquí había un bloqueo por User-Agent que incluía los patrones
# `bot`, `spider` y `crawler`. Eso rechazaba a Googlebot, Bingbot y a
# cualquier buscador — el sitio quedaba invisible para el SEO — y además
# bloqueaba a los propios scrapers del VPS (`python-requests`).
# Si hace falta frenar abuso, el camino correcto es limitar por tasa,
# no por cadena de User-Agent.
