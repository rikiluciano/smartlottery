# ============================================================
#  Seguridad y reescritura — raíz web (InfinityFree / Apache)
# ============================================================

RewriteEngine On

# ---- Forzar HTTPS ----
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- No listar directorios ----
Options -Indexes

# ---- URLs limpias: /resultados sirve resultados.php ----
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# ---- Directorios que nunca deben servirse por web ----
# En InfinityFree no se puede situar código fuera de la raíz web (htdocs es
# el DocumentRoot), así que la separación se hace aquí. Por eso `app/` es la
# única capa con lógica y está cerrada a cal y canto.
RewriteRule ^(app|vps|tests|scripts|node_modules)/ - [F,L]

# ---- Extensiones que no se sirven nunca ----
# Los JSON de datos se exponen a través de los envoltorios api_*.php, que
# añaden cabeceras de caché y un 404 correcto.
<FilesMatch "\.(json|py|md|sh|lock|flag|txt|sqlite|db|log|out|yml|yaml|dist|src\.css)$">
    Require all denied
</FilesMatch>

# ---- Configuración y credenciales ----
<FilesMatch "^(secrets|secrets\.example|tailwind\.config|package(-lock)?)\.(php|js|json)$">
    Require all denied
</FilesMatch>

# ---- Cabeceras de seguridad para todo lo estático ----
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Caché larga para assets con versión en la URL ----
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 6 months"
    ExpiresByType application/javascript  "access plus 1 month"
</IfModule>

# ---- Filtro básico de inyección en la query string ----
RewriteCond %{QUERY_STRING} (?:%27|'|%22|").*(?:%20|\s|%2B|\+)*(?:union|select|insert|update|delete|drop|truncate) [NC,OR]
RewriteCond %{QUERY_STRING} (?:%3C|<).*script.*(?:%3E|>) [NC]
RewriteRule ^ - [F]

# NOTA: aquí hubo un bloqueo por User-Agent con los patrones `bot`, `spider`
# y `crawler`. Rechazaba a Googlebot y a Bingbot —el sitio era invisible para
# los buscadores— y de paso a los propios scrapers del VPS. Para frenar abuso
# el camino es limitar por tasa, no filtrar cadenas de User-Agent.
